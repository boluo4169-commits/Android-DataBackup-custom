<resources>
    <string-array name="backup_sort_type_items_apps">
        <item>@string/alphabet</item>
        <item>@string/installation_time</item>
        <item>@string/last_update</item>
        <item>@string/data_size</item>
    </string-array>
    <string-array name="backup_sort_type_items_files">
        <item>@string/alphabet</item>
        <item>@string/data_size</item>
    </string-array>
    <string-array name="flag_type_items">
        <item>@string/both</item>
        <item>@string/third_party</item>
        <item>@string/system</item>
    </string-array>
    <string-array name="ftp_auth_mode">
        <item>@string/password</item>
        <item>@string/anonymous</item>
    </string-array>
    <string-array name="smb_auth_mode">
        <item>@string/password</item>
        <item>@string/guest</item>
        <item>@string/anonymous</item>
    </string-array>
    <string-array name="sftp_auth_mode">
        <item>@string/password</item>
        <item>@string/public_key</item>
    </string-array>
    <string-array name="kill_app_options">
        <item>@string/disabled</item>
        <item>@string/option_i</item>
        <item>@string/option_ii</item>
    </string-array>
    <string-array name="cloud_split_size_options">
        <item>@string/disabled</item>
        <item>@string/cloud_split_size_1g</item>
        <item>@string/cloud_split_size_2g</item>
        <item>@string/cloud_split_size_4g</item>
    </string-array>
    <!-- 顺序必须与 RestoreConflictStrategy.id 一致：0 替换 / 1 跳过 / 2 两份都留 -->
    <string-array name="media_restore_conflict_strategy_options">
        <item>@string/media_restore_conflict_overwrite</item>
        <item>@string/media_restore_conflict_skip</item>
        <item>@string/media_restore_conflict_keep_both</item>
        <item>@string/media_restore_conflict_ask</item>
    </string-array>
    <!-- 顺序必须与 MediaBackupStrategy.id 一致：0 替换 / 1 跳过 / 2 复制 -->
    <string-array name="media_backup_strategy_options">
        <item>@string/media_backup_strategy_replace</item>
        <item>@string/media_backup_strategy_skip</item>
        <item>@string/media_backup_strategy_copy</item>
    </string-array>
    <string-array name="media_backup_strategy_descs">
        <item>@string/media_backup_strategy_replace_desc</item>
        <item>@string/media_backup_strategy_skip_desc</item>
        <item>@string/media_backup_strategy_copy_desc</item>
    </string-array>
</resources>