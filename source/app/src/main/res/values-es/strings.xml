    <string name="compression_threads">Hilos de compresión</string>
    <string name="compression_threads_desc">Más hilos comprimen más rápido pero generan más calor. Usa menos hilos (p. ej., 2) para apps grandes como WeChat a fin de evitar la limitación térmica.</string>
